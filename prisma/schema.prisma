// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id                      Int              @id @default(autoincrement())
  nombre                  String
  descripcion             String?
  precio                  Float
  stock                   Int              @default(0)
  imagenUrl               String?          // Mantener por compatibilidad
  imagenes                ProductoImagen[]
  carrito                 CarritoItem[]
  categoria               String           @default("fimu") // fimu, perchero, etc.
  estado                  String           @default("disponible") // disponible, reservado, vendido
  reservaPolitica         Json?            @map("reserva_politica")
  reservaExpiraEn         DateTime?        @map("reserva_expira_en")
  reservaSaldoMs          Int?             @map("reserva_saldo_ms")
  reservaVersion          Int              @default(0) @map("reserva_version")
  reservadoEn             DateTime?        @map("reservado_en") // Timestamp cuando se dio click en Pagar
  compradorInfo           String?          @map("comprador_info") // Info del comprador (nombre, contacto, etc)
  reservaPausada          Boolean          @default(false) @map("reserva_pausada") // Admin puede pausar el cronómetro
  pausadoEn               DateTime?        @map("pausado_en") // Timestamp cuando se pausó
  
  // 🔑 NUEVOS CAMPOS: Para identificar quién reservó el producto
  reservadoPorSessionId   String?          @map("reservado_por_session_id") // Session ID de quien reservó
  reservadoPorUsuarioId   Int?             @map("reservado_por_usuario_id") // User ID de quien reservó
  reservadoPor            Usuario?         @relation("ProductoReservadoPor", fields: [reservadoPorUsuarioId], references: [id], onDelete: SetNull)
  
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([estado]) // Índice para filtrar por estado
  @@index([estado, reservaExpiraEn])
  @@index([createdAt]) // Índice para ordenar por fecha
  @@index([categoria]) // Índice para filtrar por categoría
  @@index([reservadoPorSessionId]) // Índice para búsquedas por sessionId
  @@index([reservadoPorUsuarioId]) // Índice para búsquedas por usuarioId
  @@map("productos")
}

model ProductoImagen {
  id             Int      @id @default(autoincrement())
  productoId     Int
  url            String
  esPrincipal    Boolean  @default(false)
  orden          Int      @default(0)
  createdAt      DateTime @default(now())
  
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId]) // Índice para búsquedas por producto
  @@index([esPrincipal]) // Índice para filtrar imagen principal
  @@map("producto_imagenes")
}

model CarritoItem {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  sessionId      String?  @map("session_id") // UUID del navegador/dispositivo para usuarios anónimos
  usuarioId      Int?     @map("usuario_id") // ID del usuario logueado (si aplica)
  cantidad       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([productoId]) // Índice para búsquedas por producto
  @@index([sessionId]) // Índice para búsquedas por sesión
  @@index([usuarioId]) // Índice para búsquedas por usuario
  // Restricción única compuesta: un producto solo puede estar una vez POR SESIÓN o POR USUARIO
  // Nota: sessionId y usuarioId son mutuamente excluyentes (uno será null)
  @@map("carrito_items")
}

model Usuario {
  configuracionesReserva ConfiguracionReserva[]
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  supabaseId          String?        @unique @map("supabase_id") // UUID de Supabase Auth
  nombre              String?
  apellido            String?
  redSocial           String?        @map("red_social") // 'facebook', 'instagram', 'tiktok', 'otro'
  nombreRedSocial     String?        @map("nombre_red_social") // El @ o nombre de usuario
  whatsapp            String?
  isAdmin             Boolean        @default(false) @map("is_admin")
  carritoItems        CarritoItem[]  // Relación con items del carrito
  productosReservados Producto[]     @relation("ProductoReservadoPor") // Productos que este usuario reservó
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([email])
  @@index([supabaseId])
  @@index([isAdmin])
  @@map("usuarios")
}

model ConfiguracionCategoria {
  id             Int      @id @default(autoincrement())
  categoria      String   @unique
  visible        Boolean  @default(true)
  nombreMostrar  String   @map("nombre_mostrar")
  icono          String?
  orden          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([categoria])
  @@index([visible])
  @@map("configuracion_categorias")
}

model ConfiguracionReserva {
  id Int @id @default(1)
  duracionMinutos Int @map("duracion_minutos")
  pausaAutomaticaHabilitada Boolean @map("pausa_automatica_habilitada")
  pausaDesdeMinuto Int @map("pausa_desde_minuto")
  pausaHastaMinuto Int @map("pausa_hasta_minuto")
  zonaHoraria String @map("zona_horaria")
  revision Int @default(1)
  actualizadoPorUsuarioId Int? @map("actualizado_por_usuario_id")
  actualizadoPor Usuario? @relation(fields: [actualizadoPorUsuarioId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("configuracion_reservas")
}
